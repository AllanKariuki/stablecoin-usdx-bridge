# --- Platform (see shared/go/platform) ---
PORT=8084
LOG_LEVEL=info

# ENV gates the local key backend. A deployment that forgot to set a backend
# must not quietly fall back to holding keys in this process's memory, so
# keystore.Resolve refuses `local` unless this is exactly "local".
ENV=local

# --- The audit log. Append-only and hash-chained: nothing else reads this
# database, nothing else writes it, and the trigger means even the owning role
# cannot edit a row. That is what makes it evidence rather than a report. ---
DATABASE_URL=postgres://signer:signer@localhost:55433/signer?sslmode=disable

# --- Key backend: local | vault | fireblocks ---
#
#   local       development only, refuses to start outside ENV=local
#   vault       Transit for ed25519 (the key never leaves), KV for secp256k1
#               (read once, signed in-process — a real weakness, which is why
#               this is the staging middle rather than the answer)
#   fireblocks  production, stubbed in this build
#
# Why not AWS KMS: it supports secp256k1 but NOT ed25519, so Solana cannot use
# it, and splitting custody across two providers doubles the surface on the one
# thing that must never be wrong.
KEY_BACKEND=local

# --- local backend. These are the two variables core-ledger no longer holds. ---
ETH_RELAYER_PRIVATE_KEY=
SOLANA_RELAYER_KEYPAIR_PATH=

# --- vault backend ---
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_KEY=usdx-solana-relayer
VAULT_KV_PATH=secret/data/usdx/eth-relayer

# --- fireblocks backend (stub) ---
FIREBLOCKS_API_KEY=
FIREBLOCKS_SECRET_PATH=
FIREBLOCKS_VAULT_ID=

# --- mTLS. Required outside ENV=local: the signer authenticates its caller
# ONLY by the certificate that completed the handshake — there is no token
# fallback, because a bearer token can be replayed by anyone who observes one
# and the thing being authorised is mint authority. ---
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CLIENT_CA_PATH=

# --- The signing policy. Mounted read-only; see policy.example.yaml. ---
POLICY_PATH=./policy.example.yaml
