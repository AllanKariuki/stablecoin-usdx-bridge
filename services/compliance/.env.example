PORT=3004
LOG_LEVEL=info

DATABASE_URL=postgres://compliance:compliance@localhost:55433/compliance?sslmode=disable

# Freezing goes through core-ledger's existing wallet status route.
CORE_LEDGER_URL=http://localhost:8081

# --- Service-to-service auth (H2 outbound). core-ledger requires a Keycloak
# service-account token on every call; compliance authenticates as the
# svc-compliance client (holding ledger.wallet-status). The same token feeds
# the workflow proposal (workflow.propose, H3). Dev values match
# infra/keycloak/templates/damp-realm.template.json — never real ones. ---
SERVICE_CLIENT_ID=svc-compliance
SERVICE_CLIENT_SECRET=dev-svc-compliance-secret
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=damp

# --- Service-to-service auth (H3 inbound). Every request to compliance must
# carry a service-account JWT with audience `compliance` (the workflow
# decision callback is @HmacAuthenticated, not public). Both required — no
# unauthenticated mode. ---
AUTH_ISSUER_URL=http://localhost:8080/realms/damp
AUTH_AUDIENCE=compliance

# Blacklist and pause go through maker-checker first. Unset means an
# enforcement action can be proposed and never executed — the correct failure
# for a service that would otherwise freeze a customer's tokens on one click.
WORKFLOW_URL=http://localhost:13006
# Must equal services/workflow's CALLBACK_SECRET; empty refuses every approval callback.
WORKFLOW_CALLBACK_SECRET=
SELF_URL=http://localhost:13004

NOTIFICATIONS_URL=http://localhost:13000

# How long a screening result is trusted. A clear screen from six months ago
# is not evidence about today's list.
SCREENING_TTL_HOURS=24

# The longest window any rule looks back over. It bounds the history query
# that runs on every posting.
HISTORY_WINDOW_MINUTES=1440

# services/audit-trail. Every decision this service makes is written to its
# own audit_outbox in the same transaction, and a relay delivers it here.
# Empty = events wait durably until it is set. The token is audit-trail's
# INGEST_TOKEN.
AUDIT_TRAIL_URL=http://localhost:18085
AUDIT_TRAIL_TOKEN=

# core-ledger publishes chain-enforcement finality (H6) to JetStream; the
# compliance-enforcement durable consumes it. Unset = the consumer does not
# start and enforcement actions stay SUBMITTED until an HTTP relay delivers.
NATS_URL=nats://localhost:54222
NATS_STREAM=DAMP
# This consumer's NATS credentials (H7). infra/nats/nats.conf declares one
# user per service with per-subject permissions; both are REQUIRED whenever
# NATS_URL is set — boot fails loudly rather than connecting anonymously and
# being refused on its subscription, which would leave enforcement finality
# unconsumed while looking healthy. Dev values match docker-compose's nats
# service; never real ones.
NATS_USER=compliance
NATS_PASSWORD=dev-compliance-password
