PORT=3004
LOG_LEVEL=info

DATABASE_URL=postgres://compliance:compliance@localhost:55433/compliance?sslmode=disable

# Freezing goes through core-ledger's existing wallet status route.
CORE_LEDGER_URL=http://localhost:8081

# Blacklist and pause go through maker-checker first. Unset means an
# enforcement action can be proposed and never executed — the correct failure
# for a service that would otherwise freeze a customer's tokens on one click.
WORKFLOW_URL=http://localhost:3006
SELF_URL=http://localhost:3004

NOTIFICATIONS_URL=http://localhost:3000

# How long a screening result is trusted. A clear screen from six months ago
# is not evidence about today's list.
SCREENING_TTL_HOURS=24

# The longest window any rule looks back over. It bounds the history query
# that runs on every posting.
HISTORY_WINDOW_MINUTES=1440
