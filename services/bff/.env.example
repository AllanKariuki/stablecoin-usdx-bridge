# --- Platform (see shared/node/nest-platform) ---
PORT=3002
LOG_LEVEL=info

# core-ledger is the one backend bff reshapes for (camelCase + Money).
CORE_LEDGER_URL=http://localhost:8081

# --- Service-to-service auth (H2). core-ledger requires a Keycloak
# service-account token on every call; bff authenticates as the svc-bff
# client (holding ledger.user-proxy). Dev values match
# infra/keycloak/templates/damp-realm.template.json — never real ones. ---
SERVICE_CLIENT_ID=svc-bff
SERVICE_CLIENT_SECRET=dev-svc-bff-secret
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=damp

# --- KYC gate (H5). POST /issuances, /redemptions, /bridges and /transfers
# check the caller's tier against KYC_MIN_TIER_ISSUANCE before any core-ledger
# call (the operator-only /deposits and /withdrawals are not gated). KYC_URL
# doubles as the KycGate base (internal tier endpoint) and the user-facing
# /kyc proxy. Empty fails the gated routes CLOSED (503 KYC_UNAVAILABLE). ---
KYC_URL=http://localhost:13007
KYC_MIN_TIER_ISSUANCE=TIER_1

# --- Upstream proxies (P3/P4/P5/P7). Empty is a supported state — the
# proxy answers 503 with a readable reason for a feature this environment
# does not run. rms and pricing serve the Ops Console's treasury workspace.
RMS_URL=http://localhost:13005
PRICING_URL=http://localhost:13009
