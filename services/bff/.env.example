# --- Platform (see shared/node/nest-platform) ---
PORT=3002
LOG_LEVEL=info

# core-ledger is the one backend bff reshapes for (camelCase + Money).
CORE_LEDGER_URL=http://localhost:8081

# --- Service-to-service auth (H2). core-ledger requires a Keycloak
# service-account token on every call; bff authenticates as the svc-bff
# client (holding ledger.user-proxy). Dev values match
# infra/keycloak/templates/damp-realm.template.json — never real ones. ---
SERVICE_CLIENT_ID=svc-bff
SERVICE_CLIENT_SECRET=dev-svc-bff-secret
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=damp
