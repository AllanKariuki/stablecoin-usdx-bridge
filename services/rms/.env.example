# --- Platform (see shared/node/nest-platform) ---
PORT=3005
LOG_LEVEL=info

# --- Database. rms owns its own Postgres database, isolated by GRANT per
# docs/building-plan.md's "one database per service, one role per service"
# decision — see infra/postgres/init/02-p3-databases.sql, applied
# automatically the first time `make up` starts Postgres against a fresh
# volume. An existing local volume needs `docker compose down -v && make up`
# to pick this up. ---
DATABASE_URL=postgres://rms:rms@localhost:55433/rms?sslmode=disable

# --- core-ledger. rms reads GET /reserves/status and writes
# POST /reserves/custodian-snapshots — the writer trust_bank_snapshot never
# had, and the reason Leg C was skipped on every reconciliation run before
# P3. ---
CORE_LEDGER_URL=http://localhost:8081
CORE_LEDGER_SERVICE_TOKEN=

# --- Custodian polling. The stub custodian reports core-ledger's own cash
# position plus a configurable drift (POST /custodians/primary/drift), which
# is what makes "force a drift, watch a LEG_C alert" a demo rather than a
# thought experiment. ---
CUSTODIAN_POLL_ENABLED=true
CUSTODIAN_POLL_SECONDS=60

# services/audit-trail. Every reserve target, custodian drift and attestation change is written to this service's own
# audit_outbox in the same transaction, and a relay delivers it here.
# Empty = events wait durably until it is set. The token is audit-trail's
# INGEST_TOKEN.
AUDIT_TRAIL_URL=http://localhost:8085
AUDIT_TRAIL_TOKEN=
