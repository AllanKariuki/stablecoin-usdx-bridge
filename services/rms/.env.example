# --- Platform (see shared/node/nest-platform) ---
PORT=3005
LOG_LEVEL=info

# --- Database. rms owns its own Postgres database, isolated by GRANT per
# docs/building-plan.md's "one database per service, one role per service"
# decision — see infra/postgres/init/02-p3-databases.sql, applied
# automatically the first time `make up` starts Postgres against a fresh
# volume. An existing local volume needs `docker compose down -v && make up`
# to pick this up. ---
DATABASE_URL=postgres://rms:rms@localhost:55433/rms?sslmode=disable

# --- core-ledger. rms reads GET /reserves/status and writes
# POST /reserves/custodian-snapshots — the writer trust_bank_snapshot never
# had, and the reason Leg C was skipped on every reconciliation run before
# P3. ---
CORE_LEDGER_URL=http://localhost:8081

# --- Service-to-service auth (H2 outbound). core-ledger requires a Keycloak
# service-account token on every call; rms authenticates as the svc-rms
# client (holding ledger.reserves.custodian). Dev values match
# infra/keycloak/templates/damp-realm.template.json — never real ones. ---
SERVICE_CLIENT_ID=svc-rms
SERVICE_CLIENT_SECRET=dev-svc-rms-secret
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=damp

# --- Service-to-service auth (H3 inbound). Every request to rms must carry
# a service-account JWT with audience `rms`. Both required — no
# unauthenticated mode. ---
AUTH_ISSUER_URL=http://localhost:8080/realms/damp
AUTH_AUDIENCE=rms

# --- Custodian polling. The stub custodian reports core-ledger's own cash
# position (or, for the BTC/ETH/SOL custodians, its crypto custody holdings)
# plus a configurable drift (POST /custodians/primary/drift), which is what
# makes "force a drift, watch a LEG_C alert" a demo rather than a thought
# experiment. Crypto statements stay in rms and reconcile through
# GET /exposure — they are never posted to core-ledger's custodian
# snapshots, which are the USD-X peg leg. ---
CUSTODIAN_POLL_ENABLED=true
CUSTODIAN_POLL_SECONDS=60

# --- Exposure. How far a crypto custodian's word may be off the ledger's
# custody holdings before GET /exposure reports DRIFT, in crypto units at
# the currency's own scale. Zero = any difference is a break. ---
CRYPTO_RECON_TOLERANCE=0

# services/audit-trail. Every reserve target, custodian drift and attestation change is written to this service's own
# audit_outbox in the same transaction, and a relay delivers it here.
# Empty = events wait durably until it is set. The token is audit-trail's
# INGEST_TOKEN.
AUDIT_TRAIL_URL=http://localhost:18085
AUDIT_TRAIL_TOKEN=
