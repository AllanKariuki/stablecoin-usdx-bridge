# --- Platform (see shared/go/platform) ---
PORT=8090
LOG_LEVEL=info

# --- Keycloak / OIDC ---
# Must be the full realm issuer, not just Keycloak's base URL.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/damp
# Must match the `aud` mapper's configured audience for damp-portal (see
# infra/keycloak/realms/damp-realm.json) — without it, Keycloak issues
# aud: ["account"] for a public client and every request is rejected.
OIDC_AUDIENCE=damp-portal

# --- Identity (services/identity) ---
# Optional. Unset falls back to using the Keycloak subject directly as the
# party id — fine for local dev before services/identity exists, wrong for
# anything real (see internal/identityclient's package doc).
IDENTITY_SERVICE_URL=
IDENTITY_CACHE_TTL=5m

# --- Redis (optional accelerator for identity lookups; auth-proxy owns no database) ---
REDIS_URL=redis://localhost:56379/0
