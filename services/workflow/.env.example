PORT=3006
LOG_LEVEL=info

# workflow's own Postgres database — see migrations/ and
# infra/postgres/init/04-p5-databases.sql.
DATABASE_URL=postgres://workflow:workflow@localhost:55433/workflow?sslmode=disable

# How often decisions are re-delivered and lapsed requests expired. An
# approval nobody hears about is the same as no approval.
CALLBACK_DRAIN_SECONDS=15
# HMAC key signing decision callbacks; callers hold it as WORKFLOW_CALLBACK_SECRET. Empty = none sent.
CALLBACK_SECRET=

# services/audit-trail. Every decision this service makes is written to its
# own audit_outbox in the same transaction, and a relay delivers it here.
# Empty = events wait durably until it is set. The token is audit-trail's
# INGEST_TOKEN.
AUDIT_TRAIL_URL=http://localhost:8085
AUDIT_TRAIL_TOKEN=
