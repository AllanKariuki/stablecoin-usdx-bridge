PORT=3006
LOG_LEVEL=info

# workflow's own Postgres database — see migrations/ and
# infra/postgres/init/04-p5-databases.sql.
DATABASE_URL=postgres://workflow:workflow@localhost:55433/workflow?sslmode=disable

# How often decisions are re-delivered and lapsed requests expired. An
# approval nobody hears about is the same as no approval.
CALLBACK_DRAIN_SECONDS=15
