PORT=3007
LOG_LEVEL=info

DATABASE_URL=postgres://kyc:kyc@localhost:55433/kyc?sslmode=disable

# Freezing and unfreezing goes through the route that already exists.
CORE_LEDGER_URL=http://localhost:8081

# Maker-checker. Unset means nothing can be approved: cases reach
# PENDING_APPROVAL and stop, which is the correct failure for a gate whose
# approval service is missing.
WORKFLOW_URL=http://localhost:3006
# Must equal services/workflow's CALLBACK_SECRET; empty refuses every approval callback.
WORKFLOW_CALLBACK_SECRET=
SELF_URL=http://localhost:3007

# --- Document storage (MinIO locally). Unset credentials return a storage key
# with no upload URL, so the flow can still be exercised end to end with the
# upload stubbed rather than 500-ing the whole KYC journey. ---
S3_ENDPOINT=http://localhost:59000
S3_BUCKET=damp-kyc
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRESIGN_EXPIRY_SECONDS=300

# services/audit-trail. Every decision this service makes is written to its
# own audit_outbox in the same transaction, and a relay delivers it here.
# Empty = events wait durably until it is set. The token is audit-trail's
# INGEST_TOKEN.
AUDIT_TRAIL_URL=http://localhost:8085
AUDIT_TRAIL_TOKEN=
