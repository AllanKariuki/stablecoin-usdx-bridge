# --- Platform (see shared/node/nest-platform) ---
PORT=3003
LOG_LEVEL=info

# --- payments' own Postgres database. See migrations/ and
# infra/postgres/init/03-p4-databases.sql (applied on a fresh volume only —
# `docker compose down -v && make up` to pick it up on an existing one). ---
DATABASE_URL=postgres://payments:payments@localhost:55433/payments?sslmode=disable

# --- core-ledger. Every intent that settles posts one journal transaction
# through /deposits, /withdrawals or /transfers. payments owns no balance. ---
CORE_LEDGER_URL=http://localhost:8081
CORE_LEDGER_SERVICE_TOKEN=

# --- notifications. Payment events are written to payments' own outbox in
# the same transaction as the settlement, and a relay delivers them here with
# backoff — so notifications being down delays an email rather than losing
# it. Empty is allowed: events queue until it is set. ---
NOTIFICATIONS_URL=http://localhost:3000
# Sweep interval for due events (each commit also kicks the relay at once).
OUTBOX_RELAY_SECONDS=5
# Attempts before an event is marked DEAD (~8h at the 5-minute backoff cap).
OUTBOX_MAX_ATTEMPTS=100

# --- Where payment links point. Not the API base — a link goes in an email
# and is opened in a browser. ---
PUBLIC_APP_URL=http://localhost:5173

# --- M-Pesa, through Safaricom's Daraja sandbox (developer.safaricom.co.ke).
# Chosen because it is free and self-service, which is the plan's test for
# whether a real integration belongs in a phase. Leaving these empty is a
# normal state — RailRegistry falls back to the stub rail and logs that it
# has. ---
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be publicly reachable for Daraja to POST to it — an ngrok tunnel
# locally. An unreachable callback URL is the single most common reason an
# STK push appears to hang forever.
# Must carry the shared secret: https://<public-host>/rails/mpesa/callback?token=<RAIL_CALLBACK_SECRET>
MPESA_CALLBACK_URL=
# Required for any HTTP rail callback; empty rejects them all.
RAIL_CALLBACK_SECRET=

STUB_RAIL_ENABLED=true

# services/audit-trail. Every payment intent, settlement, failure, bank account,
# beneficiary and invoice change is written to this service's own
# audit_outbox in the same transaction, and a relay delivers it here.
# Empty = events wait durably until it is set. The token is audit-trail's
# INGEST_TOKEN.
AUDIT_TRAIL_URL=http://localhost:8085
AUDIT_TRAIL_TOKEN=
