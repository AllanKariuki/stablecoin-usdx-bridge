# --- Platform (see shared/node/nest-platform) ---
PORT=3003
LOG_LEVEL=info

# --- payments' own Postgres database. See migrations/ and
# infra/postgres/init/03-p4-databases.sql (applied on a fresh volume only —
# `docker compose down -v && make up` to pick it up on an existing one). ---
DATABASE_URL=postgres://payments:payments@localhost:55433/payments?sslmode=disable

# --- core-ledger. Every intent that settles posts one journal transaction
# through /deposits, /withdrawals or /transfers. payments owns no balance. ---
CORE_LEDGER_URL=http://localhost:8081

# --- Service-to-service auth (H2 outbound). core-ledger requires a Keycloak
# service-account token on every call; payments authenticates as the
# svc-payments client (holding ledger.settlement). The same token feeds the
# notifications relay (notifications.ingest, H3). Dev values match
# infra/keycloak/templates/damp-realm.template.json — never real ones. ---
SERVICE_CLIENT_ID=svc-payments
SERVICE_CLIENT_SECRET=dev-svc-payments-secret
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=damp

# --- Service-to-service auth (H3 inbound). Every request to payments must
# carry a service-account JWT with audience `payments` (the rail callback is
# the one @Public route and still checks RAIL_CALLBACK_SECRET). Both
# required — there is no unauthenticated mode. ---
AUTH_ISSUER_URL=http://localhost:8080/realms/damp
AUTH_AUDIENCE=payments

# --- notifications. Payment events are written to payments' own outbox in
# the same transaction as the settlement, and a relay delivers them here with
# backoff — so notifications being down delays an email rather than losing
# it. Empty is allowed: events queue until it is set. ---
NOTIFICATIONS_URL=http://localhost:13000
# Sweep interval for due events (each commit also kicks the relay at once).
OUTBOX_RELAY_SECONDS=5
# Attempts before an event is marked DEAD (~8h at the 5-minute backoff cap).
OUTBOX_MAX_ATTEMPTS=100

# --- Where payment links point. Not the API base — a link goes in an email
# and is opened in a browser. ---
PUBLIC_APP_URL=http://localhost:5173

# --- M-Pesa, through Safaricom's Daraja sandbox (developer.safaricom.co.ke).
# Chosen because it is free and self-service, which is the plan's test for
# whether a real integration belongs in a phase. Leaving these empty is a
# normal state — RailRegistry does not register the rail and refuses intents
# that need it with RAIL_UNAVAILABLE. ---
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# B2C payouts authenticate as the API initiator configured in the Daraja
# portal, not as the business shortcode. MPESA_INITIATOR_NAME is that
# account's username; MPESA_SECURITY_CREDENTIAL is its password already
# encrypted with Safaricom's public certificate — paste the value the portal
# generates, verbatim. Both are payouts only: STK deposits work without them,
# and a payout is refused with RAIL_UNAVAILABLE until both are set. Never
# commit the credential.
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# Must be publicly reachable for Daraja to POST to it — an ngrok tunnel
# locally. An unreachable callback URL is the single most common reason an
# STK push appears to hang forever.
# Must carry the shared secret: https://<public-host>/rails/mpesa/callback?token=<RAIL_CALLBACK_SECRET>
MPESA_CALLBACK_URL=
# Required for any HTTP rail callback; empty rejects them all.
RAIL_CALLBACK_SECRET=

# Local development only. The stub settles intents with NO real money moving
# and books ledger credit for fiat that never arrived. Must be false in any
# real environment: with it off, an unconfigured rail refuses the intent
# (RAIL_UNAVAILABLE) instead of settling against the stub.
STUB_RAIL_ENABLED=true

# services/audit-trail. Every payment intent, settlement, failure, bank account,
# beneficiary and invoice change is written to this service's own
# audit_outbox in the same transaction, and a relay delivers it here.
# Empty = events wait durably until it is set. The token is audit-trail's
# INGEST_TOKEN.
AUDIT_TRAIL_URL=http://localhost:18085
AUDIT_TRAIL_TOKEN=
