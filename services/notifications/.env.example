# --- Platform. PORT below is the container port; the host publishes 13000
# because the frontend's runtime-config.js declares
# VITE_APP_WEBSOCKET_URL = ws://localhost:13000/ws and was written against it
# before this service existed (scripts/stack.sh passes PORT=13000 for host
# runs). That is also why Grafana sits on 53000. ---
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://notifications:notifications@localhost:55433/notifications?sslmode=disable

# --- WebSocket auth. A browser cannot set headers on `new WebSocket()`, so
# the upgrade never passes through Traefik's ForwardAuth — the token arrives
# as a query parameter and is verified here. Since H3 there is no unverified
# mode: with no issuer every upgrade is refused. NOTIFICATIONS_WS_DEV_AUTH is
# the one explicit escape hatch, honoured only when ENV=local — never set it
# anywhere a real user can reach the port. ---
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/damp
# Empty derives it from the issuer. docker compose sets the in-network address.
KEYCLOAK_JWKS_URL=
OIDC_AUDIENCE=damp-portal
IDENTITY_SERVICE_URL=http://localhost:13001
NOTIFICATIONS_WS_DEV_AUTH=false

# --- Service-to-service auth (H3). Inbound: every HTTP request must carry a
# service-account JWT with audience `notifications` (svc-bff carries
# notifications.user-proxy; svc-payments and core-ledger's worker carry
# notifications.ingest for /internal/*). Outbound: the identity lookup on a
# WS upgrade carries notifications' own token (identity.resolve). Dev values
# match infra/keycloak/templates/damp-realm.template.json — never real
# ones. ---
AUTH_ISSUER_URL=http://localhost:8080/realms/damp
AUTH_AUDIENCE=notifications
SERVICE_CLIENT_ID=svc-notifications
SERVICE_CLIENT_SECRET=dev-svc-notifications-secret
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=damp

# --- SMTP. Mailpit locally: SMTP on 1025, web UI on 58025 (per the plan's
# port map). Leaving SMTP_HOST empty logs emails instead of sending them. ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DAMP <no-reply@damp.local>

WEBHOOK_DRAIN_SECONDS=10

# --- NATS, for two things on one connection:
#  1. Cross-replica WebSocket fan-out. With more than one replica, a socket on
#     replica A only receives a push produced on B if every replica shares
#     NATS (core pub/sub on live.notifications.push.v1 — the socket is not the
#     durable path, `deliveries` is).
#  2. core-ledger's outbox from JetStream. If core-ledger's worker has
#     NATS_URL set, its outbox goes to the DAMP stream instead of
#     /internal/outbox, and this must be set too or those events — and
#     reconciliation alerts — never arrive. Every replica shares one durable.
# Leave empty only when core-ledger relays over HTTP (OUTBOX_RELAY_URL) and
# there is one replica. NATS being unreachable degrades pushes to in-process
# and pauses the consumer; neither fails boot. ---
NATS_URL=
# core-ledger's stream (its NATS_STREAM). core-ledger creates it.
NATS_STREAM=DAMP
# This service's NATS credentials (H7). infra/nats/nats.conf declares one
# user per service with per-subject permissions; both are REQUIRED whenever
# NATS_URL is set — boot fails with a clear error rather than connecting
# anonymously and being refused on every publish and subscription. Dev
# values match docker-compose's nats service; never real ones.
NATS_USER=notifications
NATS_PASSWORD=dev-notifications-password
# Same on every replica: that is what makes them share the work.
OUTBOX_CONSUMER_DURABLE=notifications-outbox
# Where a newly created durable starts: all (the stream's retention, deduped
# against anything already delivered over HTTP) or new.
OUTBOX_CONSUMER_DELIVER_POLICY=all
# Deliveries before a message that keeps failing is terminated and counted in
# notifications_outbox_messages_total{outcome="terminated"}.
OUTBOX_CONSUMER_MAX_DELIVERIES=10
# When > 0, the durable is created with this inactive_threshold and the
# server removes it after that long with no interest. Leave unset (0) in any
# real deployment: the durable must survive restarts. The e2e suite sets it
# because no NATS user may delete a consumer (H7), so its test durables are
# left to expire.
# OUTBOX_CONSUMER_INACTIVE_THRESHOLD_MS=60000

# --- Deliveries left PENDING by a crash. A PENDING row whose lease is older
# than PENDING_STALE_SECONDS is re-sent by a replay of its event or by the
# sweeper; after PENDING_MAX_ATTEMPTS it is marked FAILED. ---
PENDING_STALE_SECONDS=120
PENDING_MAX_ATTEMPTS=5
PENDING_SWEEP_SECONDS=30
