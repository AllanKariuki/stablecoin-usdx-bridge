# --- Platform. 3000 is not this service's choice: the frontend's
# runtime-config.js declares VITE_APP_WEBSOCKET_URL = ws://localhost:3000/ws
# and was written against it before this service existed. That is also why
# Grafana sits on 53000. ---
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://notifications:notifications@localhost:55433/notifications?sslmode=disable

# --- WebSocket auth. A browser cannot set headers on `new WebSocket()`, so
# the upgrade never passes through Traefik's ForwardAuth — the token arrives
# as a query parameter and is verified here. Leaving the issuer empty
# disables verification, which is acceptable in local development only and is
# logged loudly at boot. ---
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/damp
# Empty derives it from the issuer. docker compose sets the in-network address.
KEYCLOAK_JWKS_URL=
OIDC_AUDIENCE=damp-portal
IDENTITY_SERVICE_URL=http://localhost:3001

# --- SMTP. Mailpit locally: SMTP on 1025, web UI on 58025 (per the plan's
# port map). Leaving SMTP_HOST empty logs emails instead of sending them. ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DAMP <no-reply@damp.local>

WEBHOOK_DRAIN_SECONDS=10

# --- NATS, for two things on one connection:
#  1. Cross-replica WebSocket fan-out. With more than one replica, a socket on
#     replica A only receives a push produced on B if every replica shares
#     NATS (core pub/sub on live.notifications.push.v1 — the socket is not the
#     durable path, `deliveries` is).
#  2. core-ledger's outbox from JetStream. If core-ledger's worker has
#     NATS_URL set, its outbox goes to the DAMP stream instead of
#     /internal/outbox, and this must be set too or those events — and
#     reconciliation alerts — never arrive. Every replica shares one durable.
# Leave empty only when core-ledger relays over HTTP (OUTBOX_RELAY_URL) and
# there is one replica. NATS being unreachable degrades pushes to in-process
# and pauses the consumer; neither fails boot. ---
NATS_URL=
# core-ledger's stream (its NATS_STREAM). core-ledger creates it.
NATS_STREAM=DAMP
# Same on every replica: that is what makes them share the work.
OUTBOX_CONSUMER_DURABLE=notifications-outbox
# Where a newly created durable starts: all (the stream's retention, deduped
# against anything already delivered over HTTP) or new.
OUTBOX_CONSUMER_DELIVER_POLICY=all
# Deliveries before a message that keeps failing is terminated and counted in
# notifications_outbox_messages_total{outcome="terminated"}.
OUTBOX_CONSUMER_MAX_DELIVERIES=10

# --- Deliveries left PENDING by a crash. A PENDING row whose lease is older
# than PENDING_STALE_SECONDS is re-sent by a replay of its event or by the
# sweeper; after PENDING_MAX_ATTEMPTS it is marked FAILED. ---
PENDING_STALE_SECONDS=120
PENDING_MAX_ATTEMPTS=5
PENDING_SWEEP_SECONDS=30
