PORT=3008
LOG_LEVEL=info

DATABASE_URL=postgres://reporting:reporting@localhost:55433/reporting?sslmode=disable

# Every figure in every report is read from the service that owns it at run
# time. This service owns no numbers.
CORE_LEDGER_URL=http://localhost:8081
AUDIT_TRAIL_URL=http://localhost:18085

# --- Service-to-service auth (H2 outbound). core-ledger requires a Keycloak
# service-account token on every call; reporting authenticates as the
# svc-reporting client (holding ledger.reports.read). The same token feeds
# its audit-trail extract (audit-trail.user-proxy, H3). Dev values match
# infra/keycloak/templates/damp-realm.template.json — never real ones. ---
SERVICE_CLIENT_ID=svc-reporting
SERVICE_CLIENT_SECRET=dev-svc-reporting-secret
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=damp

# --- Service-to-service auth (H3 inbound). Every request to reporting must
# carry a service-account JWT with audience `reporting`. Both required — no
# unauthenticated mode. ---
AUTH_ISSUER_URL=http://localhost:8080/realms/damp
AUTH_AUDIENCE=reporting

# --- Superset. The admin credential stays in this process: the frontend used
# to call the guest-token endpoint directly from the browser, and that
# endpoint requires exactly this credential. ---
SUPERSET_URL=http://localhost:8088
SUPERSET_ADMIN_USERNAME=
SUPERSET_ADMIN_PASSWORD=

# services/audit-trail is also where this service's own audit events go:
# every report run, CSV export and Superset guest token is written to
# audit_outbox in the same transaction, and a relay delivers it to
# AUDIT_TRAIL_URL. The token is audit-trail's INGEST_TOKEN.
AUDIT_TRAIL_TOKEN=
