PORT=3008
LOG_LEVEL=info

DATABASE_URL=postgres://reporting:reporting@localhost:55433/reporting?sslmode=disable

# Every figure in every report is read from the service that owns it at run
# time. This service owns no numbers.
CORE_LEDGER_URL=http://localhost:8081
AUDIT_TRAIL_URL=http://localhost:8085

# --- Superset. The admin credential stays in this process: the frontend used
# to call the guest-token endpoint directly from the browser, and that
# endpoint requires exactly this credential. ---
SUPERSET_URL=http://localhost:8088
SUPERSET_ADMIN_USERNAME=
SUPERSET_ADMIN_PASSWORD=

# services/audit-trail is also where this service's own audit events go:
# every report run, CSV export and Superset guest token is written to
# audit_outbox in the same transaction, and a relay delivers it to
# AUDIT_TRAIL_URL. The token is audit-trail's INGEST_TOKEN.
AUDIT_TRAIL_TOKEN=
