PORT=8085
LOG_LEVEL=info

# The audit trail's own database. Nothing else reads it, nothing else writes
# it, and the append-only trigger means even this role cannot edit a row —
# which is what makes the log evidence rather than a report.
DATABASE_URL=postgres://audit_trail:audit_trail@localhost:55433/audit_trail?sslmode=disable

# --- Anchoring. A Merkle root over a window of events, published somewhere
# this platform does not control.
#
# The hash chain already proves nothing was removed. What it cannot prove is
# WHEN a row was written: somebody with database access can rewrite the chain
# from any point and produce a log that verifies perfectly. An external root
# fixes everything it covers as of that moment. ---
ANCHOR_INTERVAL=1h
ANCHOR_MIN_EVENTS=1
ANCHOR_MAX_EVENTS=50000

# "log" (the default, and deliberately weak — a root in a log this platform
# controls proves nothing an attacker with that control could not also
# rewrite; its value is that Loki is a different system with a different set
# of people who can delete from it) or "none", which still computes and
# stores every root so publishing later remains possible.
ANCHOR_PUBLISHER=log
