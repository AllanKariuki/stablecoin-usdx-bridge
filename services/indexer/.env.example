# --- Platform (see shared/go/platform) ---
PORT=8083
LOG_LEVEL=info

# --- The indexer's own TimescaleDB, in its own container (see
# docker-compose.yaml's `timescaledb` service and
# infra/timescaledb/init/01-indexer-db.sql). chain_events is an append-heavy
# time series; the journal is a transactional ledger. They want different
# tuning, which is why the plan puts TimescaleDB in its own container. ---
DATABASE_URL=postgres://indexer:indexer@localhost:55434/indexer?sslmode=disable

# --- core-ledger. The indexer writes chain supply snapshots through
# POST /reserves/chain-supply-snapshots — the writer eth/sol_supply_snapshot
# have never had. ---
CORE_LEDGER_URL=http://localhost:8081
CORE_LEDGER_SERVICE_TOKEN=

# --- Ethereum. Same proxy address core-ledger binds to — never the bare
# implementation address. ---
ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
USDX_PROXY_ADDRESS=0xba07d6...
# Read at runtime, not embedded: shared/abi/USDX.json lives outside this Go
# module. The Docker image bakes it to /app/abi/USDX.json.
USDX_ABI_PATH=../../shared/abi/USDX.json

# --- Solana ---
SOLANA_RPC_URL=https://api.devnet.solana.com
USDX_PROGRAM_ID=9GFGtYx...
USDX_MINT_ADDRESS=

# --- Indexing. ETH_CONFIRMATIONS is the depth at which this platform treats
# a Sepolia block as settled — deliberately a number DAMP chooses rather than
# the consensus layer's `finalized` checkpoint, which is ~15 minutes behind
# and made every mint wait for it. SOL_CONFIRMATIONS is 0 because the Solana
# source already reads at the `finalized` commitment. ---
ETH_CONFIRMATIONS=12
SOL_CONFIRMATIONS=0
REORG_DEPTH=128
INDEX_BATCH_SIZE=2000
INDEX_POLL_INTERVAL=5s
SUPPLY_REPORT_INTERVAL=60s

# Where a cold cursor starts. Leave at 0 for "one reorg window behind the safe
# head" — indexing a chain from genesis to find a contract deployed last month
# is days of RPC calls for nothing. Set to the deployment block for a full
# history.
ETH_START_HEIGHT=0
SOL_START_HEIGHT=0

# Run Ethereum-only when no devnet validator is part of the environment. Honest
# about the consequence: Leg A then compares against a stale SPL supply.
DISABLE_SOLANA=false
