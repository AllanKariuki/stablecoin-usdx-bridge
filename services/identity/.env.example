# --- Platform (see shared/node/nest-platform) ---
PORT=3001
LOG_LEVEL=info

# --- Database. identity owns its own Postgres database, isolated by GRANT
# per docs/building-plan.md's "one database per service, one role per
# service" decision — see infra/postgres/init/01-identity-db.sql, applied
# automatically the first time `make up` starts Postgres against a fresh
# volume. An existing local volume needs `docker compose down -v && make up`
# to pick this up. ---
DATABASE_URL=postgres://identity:identity@localhost:55433/identity?sslmode=disable

# --- core-ledger. The only other service identity calls: POST /wallets, to
# ensure a party's default fiat wallet exists once provisioned. ---
CORE_LEDGER_URL=http://localhost:8081

# --- Keycloak Admin API. identity authenticates as the confidential
# "identity-service" client (client-credentials grant) already provisioned
# in infra/keycloak/realms/damp-realm.json, scoped to exactly the
# realm-management roles it needs (manage-users/view-users/query-users/
# manage-realm), fullScopeAllowed off. ---
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=damp
KEYCLOAK_ADMIN_CLIENT_ID=identity-service
# Matches damp-realm.json's placeholder secret for local dev only.
KEYCLOAK_ADMIN_CLIENT_SECRET=__CHANGE_ME_IN_A_REAL_ENVIRONMENT__
