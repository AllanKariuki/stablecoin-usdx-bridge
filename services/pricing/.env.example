# --- Platform (see shared/node/nest-platform) ---
PORT=3006
LOG_LEVEL=info

# --- Database. pricing owns its own Postgres database, isolated by GRANT
# per docs/building-plan.md's "one database per service, one role per
# service" decision — see infra/postgres/init/07-pricing-database.sql,
# applied automatically the first time `make up` starts Postgres against a
# fresh volume. An existing local volume needs
# `docker compose down -v && make up` to pick this up. ---
DATABASE_URL=postgres://pricing:pricing@localhost:55433/pricing?sslmode=disable

# --- core-ledger. pricing writes POST /fx/quotes — the seam every FX
# conversion and FX payment consumes its rate from. ---
CORE_LEDGER_URL=http://localhost:8081

# --- Service-to-service auth (H2 outbound). core-ledger requires a Keycloak
# service-account token on every call; pricing authenticates as the
# svc-pricing client (holding ledger.pricing — the only holder). Dev values
# match infra/keycloak/templates/damp-realm.template.json — never real
# ones. ---
SERVICE_CLIENT_ID=svc-pricing
SERVICE_CLIENT_SECRET=dev-svc-pricing-secret
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=damp

# --- Service-to-service auth (H3 inbound). Every request to pricing must
# carry a service-account JWT with audience `pricing`. Both required — no
# unauthenticated mode. ---
AUTH_ISSUER_URL=http://localhost:8080/realms/damp
AUTH_AUDIENCE=pricing

# --- Feeds. Comma-separated names from coinbase, kraken, fiat, stub.
# "stub" alone keeps the stack fully offline (fixed rates below);
# coinbase+kraken+fiat is the production shape. scripts/stack.sh overrides
# these for the host-run stack. ---
PRICING_FEEDS=coinbase,kraken,fiat
# PRICING_STUB_RATES={"BTC/USD":"100000.00","ETH/USD":"3500.00","SOL/USD":"200.00","USD/EUR":"0.92","USD/GBP":"0.79","USD/KES":"129.50"}
PRICING_STUB_RATES=

# --- Aggregation policy. Crypto needs 2 fresh sources within 30s; any two
# sources disagreeing by more than 150bps trip the symbol. Fiat is a daily
# reference rate: 1 source, 1h freshness. ---
PRICING_POLL_MS=5000
PRICING_MIN_SOURCES=2
PRICING_MAX_AGE_MS=30000
PRICING_MAX_DEVIATION_BPS=150
PRICING_FIAT_MIN_SOURCES=1
PRICING_FIAT_MAX_AGE_MS=3600000

# --- Exposure. Per-quote ceilings live in pricing_pairs; this is the
# per-party OUTSTANDING cap in USD — the sum of unexpired, still-consumable
# quotes plus in-flight reservations. Daily/tiered spend limits belong to
# bff/KYC tiers, not here. ---
PRICING_PARTY_OUTSTANDING_USD=25000

# services/audit-trail. Every pair-policy change is written to this
# service's own audit_outbox in the same transaction, and a relay delivers
# it here. Empty = events wait durably until it is set. The token is
# audit-trail's INGEST_TOKEN.
AUDIT_TRAIL_URL=http://localhost:18085
AUDIT_TRAIL_TOKEN=
