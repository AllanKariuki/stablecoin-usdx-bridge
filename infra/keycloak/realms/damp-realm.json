      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "workflow",
      "name": "workflow API (resource)",
      "description": "Bearer-only resource client for services/workflow: holds workflow.user-proxy and workflow.propose.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
