{
  "realm": "damp",
  "enabled": true,
  "displayName": "DAMP",
  "displayNameHtml": "<strong>DAMP</strong>",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "loginTheme": "damp",
  "accountTheme": "keycloak.v3",
  "defaultRole": {
    "name": "default-roles-damp",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false,
    "composites": {
      "realm": [
        "offline_access",
        "uma_authorization",
        "customer"
      ]
    }
  },
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Platform/IT administrator. Deliberately excludes kyc:review, compliance:cases:manage, compliance:blacklist:manage, and ledger:admin — see the segregation-of-duties note above."
      },
      {
        "name": "auditor",
        "description": "Independent read-only oversight."
      },
      {
        "name": "company",
        "description": "An organization account acting on behalf of itself and its sub-accounts."
      },
      {
        "name": "compliance",
        "description": "AML/KYC compliance officer."
      },
      {
        "name": "customer",
        "description": "A retail individual acting on their own behalf."
      },
      {
        "name": "treasury",
        "description": "Financial/ledger administration, reserves, and fee schedules."
      },
      {
        "name": "offline_access"
      },
      {
        "name": "uma_authorization"
      },
      {
        "name": "default-roles-damp",
        "description": "${role_default-roles}",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "customer"
          ]
        }
      }
    ],
    "client": {
      "core-ledger": [
        {
          "name": "ledger.user-proxy",
          "description": "services/bff: every user-facing route plus the operator surface (fx/*, ledger/fees, ledger/journals, dead-letters)",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "ledger.settlement",
          "description": "services/payments: POST /wallets, /deposits, /withdrawals, /transfers",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "ledger.wallet-provision",
          "description": "services/identity: POST /wallets (default wallet on provisioning)",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "ledger.wallet-status",
          "description": "services/kyc + services/compliance: GET /users/:id/wallets, POST /wallets/:id/status",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "ledger.reserves.custodian",
          "description": "services/rms: POST /reserves/custodian-snapshots, GET /reserves/status",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "ledger.reserves.chain-supply",
          "description": "services/indexer: POST /reserves/chain-supply-snapshots",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "ledger.reports.read",
          "description": "services/reporting: the GET surface a report run assembles (statements, transactions, trial-balance, reserves)",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "groups": [
    {
      "name": "orgs",
      "subGroups": [
        {
          "name": "damp-demo-co",
          "attributes": {
            "org_id": [
              "org_demo_co"
            ]
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "damp-portal",
      "name": "DAMP Self-Service portal",
      "description": "Public SPA client — matches frontend/public/runtime-config.js. PKCE pre-configured; directAccessGrantsEnabled stays on until authUtils.ts migrates off password grant (see docs/building-plan.md P1).",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/auth/callback",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "aud-mapper-damp-portal",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "damp-portal",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "org-id-group-attribute",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "damp-ops",
      "name": "DAMP Ops Console",
      "description": "Public SPA client for frontend/ops-console (admin, compliance, treasury, auditor). PKCE S256 only, no password grant. Its aud mapper adds damp-portal so auth-proxy's single audience check accepts its tokens.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5174/auth/callback",
        "http://localhost:5174/*"
      ],
      "webOrigins": [
        "http://localhost:5174"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5174/*"
      },
      "protocolMappers": [
        {
          "name": "aud-mapper-damp-portal",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "damp-portal",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "org-id-group-attribute",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "identity-service",
      "name": "services/identity (confidential)",
      "description": "Service account with Keycloak Admin API access, scoped to exactly the realm-management roles services/identity needs (fullScopeAllowed off). Also carries ledger.wallet-provision for its core-ledger POST /wallets call (H2).",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "secret": "__CHANGE_ME_IN_A_REAL_ENVIRONMENT__",
      "protocolMappers": [
        {
          "name": "aud-mapper-core-ledger",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "core-ledger",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "core-ledger",
      "name": "core-ledger API (resource)",
      "description": "Bearer-only resource client. No flows, no service account: it exists to hold the client roles (see roles.client) that authorize calls to core-ledger's HTTP API, and to be the aud every service-account token names.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "svc-bff",
      "name": "services/bff (confidential)",
      "description": "Service account for services/bff: client-credentials only, carrying ledger.user-proxy for its core-ledger calls (H2).",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "secret": "dev-svc-bff-secret",
      "protocolMappers": [
        {
          "name": "aud-mapper-core-ledger",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "core-ledger",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "svc-payments",
      "name": "services/payments (confidential)",
      "description": "Service account for services/payments: client-credentials only, carrying ledger.settlement (POST /wallets, /deposits, /withdrawals, /transfers).",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "secret": "dev-svc-payments-secret",
      "protocolMappers": [
        {
          "name": "aud-mapper-core-ledger",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "core-ledger",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "svc-kyc",
      "name": "services/kyc (confidential)",
      "description": "Service account for services/kyc: client-credentials only, carrying ledger.wallet-status (list a party's wallets, freeze/thaw).",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "secret": "dev-svc-kyc-secret",
      "protocolMappers": [
        {
          "name": "aud-mapper-core-ledger",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "core-ledger",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "svc-compliance",
      "name": "services/compliance (confidential)",
      "description": "Service account for services/compliance: client-credentials only, carrying ledger.wallet-status (list a party's wallets, freeze/thaw).",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "secret": "dev-svc-compliance-secret",
      "protocolMappers": [
        {
          "name": "aud-mapper-core-ledger",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "core-ledger",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "svc-rms",
      "name": "services/rms (confidential)",
      "description": "Service account for services/rms: client-credentials only, carrying ledger.reserves.custodian (POST /reserves/custodian-snapshots, GET /reserves/status).",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "secret": "dev-svc-rms-secret",
      "protocolMappers": [
        {
          "name": "aud-mapper-core-ledger",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "core-ledger",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "svc-reporting",
      "name": "services/reporting (confidential)",
      "description": "Service account for services/reporting: client-credentials only, carrying ledger.reports.read (the GET surface a report run assembles).",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "secret": "dev-svc-reporting-secret",
      "protocolMappers": [
        {
          "name": "aud-mapper-core-ledger",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "core-ledger",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "svc-indexer",
      "name": "services/indexer (confidential)",
      "description": "Service account for services/indexer: client-credentials only, carrying ledger.reserves.chain-supply (POST /reserves/chain-supply-snapshots).",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "secret": "dev-svc-indexer-secret",
      "protocolMappers": [
        {
          "name": "aud-mapper-core-ledger",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "core-ledger",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "identity-service",
        "roles": [
          "view-users",
          "query-users",
          "manage-realm",
          "manage-users"
        ]
      }
    ],
    "core-ledger": [
      {
        "client": "svc-bff",
        "roles": [
          "ledger.user-proxy"
        ]
      },
      {
        "client": "svc-payments",
        "roles": [
          "ledger.settlement"
        ]
      },
      {
        "client": "identity-service",
        "roles": [
          "ledger.wallet-provision"
        ]
      },
      {
        "client": "svc-kyc",
        "roles": [
          "ledger.wallet-status"
        ]
      },
      {
        "client": "svc-compliance",
        "roles": [
          "ledger.wallet-status"
        ]
      },
      {
        "client": "svc-rms",
        "roles": [
          "ledger.reserves.custodian"
        ]
      },
      {
        "client": "svc-reporting",
        "roles": [
          "ledger.reports.read"
        ]
      },
      {
        "client": "svc-indexer",
        "roles": [
          "ledger.reserves.chain-supply"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "service-account-identity-service",
      "enabled": true,
      "serviceAccountClientId": "identity-service",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
