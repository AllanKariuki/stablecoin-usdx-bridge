{
  "realm": "damp",
  "enabled": true,
  "displayName": "DAMP",
  "displayNameHtml": "<strong>DAMP</strong>",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "loginTheme": "damp",
  "accountTheme": "keycloak.v3",
  "defaultRole": {
    "name": "default-roles-damp",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false,
    "composites": {
      "realm": [
        "offline_access",
        "uma_authorization",
        "customer"
      ]
    }
  },
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Platform/IT administrator. Deliberately excludes kyc:review, compliance:cases:manage, compliance:blacklist:manage, and ledger:admin — see the segregation-of-duties note above."
      },
      {
        "name": "auditor",
        "description": "Independent read-only oversight."
      },
      {
        "name": "company",
        "description": "An organization account acting on behalf of itself and its sub-accounts."
      },
      {
        "name": "compliance",
        "description": "AML/KYC compliance officer."
      },
      {
        "name": "customer",
        "description": "A retail individual acting on their own behalf."
      },
      {
        "name": "treasury",
        "description": "Financial/ledger administration, reserves, and fee schedules."
      },
      {
        "name": "offline_access"
      },
      {
        "name": "uma_authorization"
      },
      {
        "name": "default-roles-damp",
        "description": "${role_default-roles}",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "customer"
          ]
        }
      }
    ],
    "client": {
      "core-ledger": [
        {
          "name": "ledger.user-proxy",
          "description": "services/bff: every user-facing route plus the operator surface (fx/*, ledger/fees, ledger/journals, dead-letters)",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "ledger.settlement",
          "description": "services/payments: POST /wallets, /deposits, /withdrawals, /transfers",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "ledger.wallet-provision",
          "description": "services/identity: POST /wallets (default wallet on provisioning)",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "ledger.wallet-status",
          "description": "services/kyc + services/compliance: GET /users/:id/wallets, POST /wallets/:id/status",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "ledger.reserves.custodian",
          "description": "services/rms: POST /reserves/custodian-snapshots, GET /reserves/status",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "ledger.reserves.chain-supply",
          "description": "services/indexer: POST /reserves/chain-supply-snapshots",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "ledger.reports.read",
          "description": "services/reporting: the GET surface a report run assembles (statements, transactions, trial-balance, reserves)",
          "composite": false,
          "clientRole": true
        }
      ],
      "payments": [
        {
          "name": "payments.user-proxy",
          "description": "services/bff: every user-facing payments route (banks, payment-intents, invoices)",
          "composite": false,
          "clientRole": true
        }
      ],
      "workflow": [
        {
          "name": "workflow.user-proxy",
          "description": "services/bff: the approval surface the browser reaches",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "workflow.propose",
          "description": "services/kyc + services/compliance: POST /approval-requests on their own behalf (the X-User-Id they send is audit-only)",
          "composite": false,
          "clientRole": true
        }
      ],
      "kyc": [
        {
          "name": "kyc.user-proxy",
          "description": "services/bff: every user-facing kyc route",
          "composite": false,
          "clientRole": true
        }
      ],
      "compliance": [
        {
          "name": "compliance.user-proxy",
          "description": "services/bff: every user-facing compliance route",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "compliance.ingest",
          "description": "svc-core-ledger-worker: POST /internal/outbox (ledger events)",
          "composite": false,
          "clientRole": true
        }
      ],
      "reporting": [
        {
          "name": "reporting.user-proxy",
          "description": "services/bff: every user-facing reporting route",
          "composite": false,
          "clientRole": true
        }
      ],
      "rms": [
        {
          "name": "rms.user-proxy",
          "description": "services/bff: every user-facing rms route",
          "composite": false,
          "clientRole": true
        }
      ],
      "notifications": [
        {
          "name": "notifications.user-proxy",
          "description": "services/bff: notifications, preferences and webhooks for the signed-in user",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "notifications.ingest",
          "description": "svc-payments (POST /internal/events) + svc-core-ledger-worker (POST /internal/outbox): cluster-internal event ingestion",
          "composite": false,
          "clientRole": true
        }
      ],
      "identity": [
        {
          "name": "identity.user-proxy",
          "description": "services/bff: user-facing identity routes (no bff proxy mounts them yet; granted for when one does)",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "identity.resolve",
          "description": "svc-auth-proxy + svc-notifications: GET /internal/parties/by-subject/:subject",
          "composite": false,
          "clientRole": true
        }
      ],
      "audit-trail": [
        {
          "name": "audit-trail.user-proxy",
          "description": "services/bff + services/reporting: the read surface (GET /audit/*)",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "audit-trail.ingest",
          "description": "every producer's service client: POST /internal/events (accepted alongside INGEST_TOKEN until producers migrate)",
          "composite": false,
          "clientRole": true
        }
      ],
      "indexer": [
        {
          "name": "indexer.finality",
          "description": "svc-core-ledger-worker: GET /finality/:chain/:txHash (the saga's finality check)",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "groups": [
    {
      "name": "orgs",
      "subGroups": [
        {
          "name": "damp-demo-co",
          "attributes": {
            "org_id": [
              "org_demo_co"
            ]
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "damp-portal",
      "name": "DAMP Self-Service portal",
      "description": "Public SPA client — matches frontend/public/runtime-config.js. PKCE pre-configured; directAccessGrantsEnabled stays on until authUtils.ts migrates off password grant (see docs/building-plan.md P1).",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/auth/callback",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "aud-mapper-damp-portal",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "damp-portal",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "org-id-group-attribute",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "damp-ops",
      "name": "DAMP Ops Console",
      "description": "Public SPA client for frontend/ops-console (admin, compliance, treasury, auditor). PKCE S256 only, no password grant. Its aud mapper adds damp-portal so auth-proxy's single audience check accepts its tokens.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5174/auth/callback",
        "http://localhost:5174/*"
      ],
      "webOrigins": [
        "http://localhost:5174"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5174/*"
      },
      "protocolMappers": [
        {
          "name": "aud-mapper-damp-portal",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "damp-portal",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "org-id-group-attribute",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "identity-service",
      "name": "services/identity (confidential)",
      "description": "Service account with Keycloak Admin API access, scoped to exactly the realm-management roles services/identity needs (fullScopeAllowed off). Also carries ledger.wallet-provision for its core-ledger POST /wallets call (H2) and audit-trail.ingest (H3).",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "secret": "__CHANGE_ME_IN_A_REAL_ENVIRONMENT__",
      "protocolMappers": [
        {
          "name": "aud-mapper-core-ledger",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "core-ledger",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "aud-mapper-audit-trail",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "audit-trail",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
