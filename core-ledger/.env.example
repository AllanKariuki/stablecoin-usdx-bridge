# --- Platform (see shared/go/platform) ---
# Both optional — PORT defaults to 8081 (not 8080, which Keycloak owns),
# LOG_LEVEL defaults to info. debug/warn/error also accepted.
PORT=8081
LOG_LEVEL=info

# Postgres connection string for the ledger DB (see internal/ledger/migrations).
DATABASE_URL=postgres://bridge:bridge@localhost:55433/bridge?sslmode=disable

# --- Ethereum ---
ETH_RPC_URL=
# The USDX proxy (ERC1967Proxy) address from `forge script script/USDX.s.sol`
# — never the bare implementation address.
USDX_PROXY_ADDRESS=
# Hex-encoded private key (0x-prefixed or not) for the address holding
# BRIDGE_ROLE on USDX.sol. Whoever holds this key can mint/burn arbitrarily
# up to the contract's own guards — treat it like the relayer's signing key
# it is, not a throwaway dev key, even in this .env.example.
ETH_RELAYER_PRIVATE_KEY=

# --- Solana ---
SOLANA_RPC_URL=http://localhost:8899
# usdx_bridge's deployed program ID (matches Anchor.toml's
# [programs.localnet] entry, and lib.rs's declare_id!).
USDX_PROGRAM_ID=
# The SPL mint created by initialize_mint_authority.
USDX_MINT_ADDRESS=
# Path to a solana-keygen JSON keypair file for the account configured as
# RELAYER_PUBKEY in constants.rs.
SOLANA_RELAYER_KEYPAIR_PATH=

# ---------------------------------------------------------------------------
# P3 — on-chain truth
# ---------------------------------------------------------------------------

# Where the outbox relay publishes. NATS wins over OUTBOX_RELAY_URL when both
# are set — one relay, one destination. Leaving both empty is a supported
# state, not a degraded one: events accumulate durably in the outbox and are
# delivered whenever a destination appears, which is the whole reason the
# table was built before there was anything to publish to.
NATS_URL=nats://localhost:54222
NATS_STREAM=DAMP

# Points the saga's finality check at services/indexer instead of an RPC poll.
# Beyond latency (Sepolia's `finalized` checkpoint is ~15 minutes behind), the
# indexer can distinguish "not seen yet" from "seen and then orphaned" — which
# a receipt poll cannot, so a reorged mint looked identical to a slow one and
# the saga would wait for it forever. Empty keeps the pre-P3 behaviour exactly.
INDEXER_URL=http://localhost:8083

# Reconciliation (cmd/reconcile). PREFER_SNAPSHOTS reads chain supply from the
# indexer rather than calling the chains; SNAPSHOT_MAX_AGE is the guard against
# an indexer that has silently stopped, which would otherwise leave a
# perfectly well-formed and increasingly wrong number that every run passes
# against.
RECONCILE_PREFER_SNAPSHOTS=true
RECONCILE_SNAPSHOT_MAX_AGE=10m

# A CronJob pod lives for about two seconds and can never be scraped, so
# reconcile pushes its gauges. Without this the metric-based paging P3 is
# built around silently never fires. Empty is fine for `--watch` and local runs.
PUSHGATEWAY_URL=http://localhost:59091

# ---------------------------------------------------------------------------
# P6 — key custody
#
# With SIGNER_URL set, ETH_RELAYER_PRIVATE_KEY and
# SOLANA_RELAYER_KEYPAIR_PATH above are IGNORED and this process holds no key
# material at all — which is P6's whole goal. Config validation enforces the
# either/or at boot rather than letting a deployment with neither start
# happily and fail at the first mint.
#
# The client certificate is how the signer authenticates this caller. There is
# no token fallback, deliberately.
# ---------------------------------------------------------------------------
SIGNER_URL=https://localhost:8084
SIGNER_CLIENT_CERT_PATH=
SIGNER_CLIENT_KEY_PATH=
SIGNER_CA_PATH=
SIGNER_ETH_KEY_ID=eth-relayer
SIGNER_SOL_KEY_ID=sol-relayer
